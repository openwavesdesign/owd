---
import Wordmark from './Wordmark.astro';
import { site, nav } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer section--navy">
  <div class="container cols">
    <div class="about">
      <Wordmark inverse />
      <p>
        Websites for small businesses in {site.region} and beyond. Designed, built and launched by {site.owner}.
      </p>
    </div>

    <nav aria-label="Footer">
      <h2 class="label">Explore</h2>
      <ul>
        <li><a href="/">Home</a></li>
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        <li><a href="/free-website-audit/">Free Site Audit</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="label">Get in touch</h2>
      <ul>
        <li>Call or text <a href={`tel:${site.phone}`}>{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.googleReviewsUrl} rel="noopener" target="_blank">Find us on Google</a></li>
      </ul>
    </div>
  </div>

  <div class="container legal">
    <p>&copy; {year} {site.name}. All rights reserved.</p>
    <p>Serving {site.areas.join(' · ')}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    padding-block: 4.5rem 2rem;
    font-size: 1rem;
  }
  .cols {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 2fr 1fr 1.4fr;
  }
  .about p {
    margin-top: 1.25rem;
    max-width: 22rem;
    opacity: 0.85;
  }
  .label {
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal);
    margin-bottom: 1rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  a {
    text-decoration-color: rgb(244 230 216 / 0.4);
  }
  a:hover {
    text-decoration-color: var(--coral);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(244 230 216 / 0.18);
    font-family: var(--font-head);
    font-size: 0.8rem;
    opacity: 0.75;
  }
  .legal p {
    margin: 0;
  }
  @media (max-width: 760px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
