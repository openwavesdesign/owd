---
import { plans } from '../config/content';
import { site } from '../config/site';
import { calendlyEmbedUrl } from '../lib/calendly';

const popupUrl = calendlyEmbedUrl(site.calendly.discoveryUrl);
---

<div class="pricing">
  {
    plans.map((plan) => (
      <article class:list={['plan', { featured: plan.featured }]}>
        {plan.featured && <span class="badge">Most popular</span>}
        <h3>{plan.name}</h3>
        <p class="tagline">{plan.tagline}</p>
        <p class="price">{plan.price}</p>
        <ul class="check-list">
          {plan.features.map((f) => (
            <li>{f}</li>
          ))}
        </ul>
        <a
          href="/contact/#book"
          class:list={['btn', plan.featured ? 'btn--primary' : 'btn--secondary']}
          data-calendly-popup={popupUrl}
        >
          Book a free call<span class="visually-hidden"> about {plan.name}</span>
        </a>
      </article>
    ))
  }
</div>

<script>
  // Open the Calendly scheduler in a pop-up. Its script and styles load on the first click only,
  // so pages with pricing don't pull in Calendly until someone wants to book.
  // If Calendly can't load, the link falls back to the booking section on /contact/.
  type CalendlyGlobal = { initPopupWidget: (opts: { url: string }) => void };
  const w = window as typeof window & { Calendly?: CalendlyGlobal };
  let loading: Promise<void> | undefined;

  function loadCalendly(): Promise<void> {
    loading ??= new Promise((resolve, reject) => {
      const css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = 'https://assets.calendly.com/assets/external/widget.css';
      document.head.append(css);
      const js = document.createElement('script');
      js.src = 'https://assets.calendly.com/assets/external/widget.js';
      js.onload = () => resolve();
      js.onerror = () => reject(new Error('Calendly failed to load'));
      document.head.append(js);
    });
    return loading;
  }

  document.querySelectorAll<HTMLAnchorElement>('a[data-calendly-popup]').forEach((link) => {
    link.addEventListener('click', async (event) => {
      event.preventDefault();
      try {
        await loadCalendly();
        w.Calendly!.initPopupWidget({ url: link.dataset.calendlyPopup! });
      } catch {
        loading = undefined;
        window.location.href = link.href;
      }
    });
  });
</script>

<style>
  .pricing {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    align-items: stretch;
  }
  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 2.25rem 2rem 2rem;
  }
  .plan.featured {
    border: 2px solid var(--navy);
    box-shadow: var(--shadow);
  }
  .badge {
    position: absolute;
    top: -0.85rem;
    left: 2rem;
    background: var(--navy);
    color: var(--paper);
    font-family: var(--font-head);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
  }
  h3 {
    margin-bottom: 0.35rem;
  }
  .tagline {
    color: var(--gray);
    font-size: 1rem;
    min-height: 3.2em;
  }
  .price {
    font-family: var(--font-head);
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }
  ul {
    font-size: 1rem;
    margin-bottom: 2rem;
  }
  .btn {
    margin-top: auto;
  }
</style>
