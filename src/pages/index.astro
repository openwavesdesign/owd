---
import Base from '../layouts/Base.astro';
import Pricing from '../components/Pricing.astro';
import Process from '../components/Process.astro';
import Testimonial from '../components/Testimonial.astro';
import AuditCta from '../components/AuditCta.astro';
import { site } from '../config/site';
import { clientTypes } from '../config/content';

const features = [
  {
    title: 'Designed for your brand',
    body: 'A custom-designed site that captures your aesthetic, builds trust instantly, and feels unmistakably like you.',
    icon: '<path d="M12 3a9 9 0 1 0 0 18c1 0 1.5-.7 1.5-1.5 0-.4-.2-.8-.4-1.1-.3-.3-.4-.7-.4-1.1 0-.8.7-1.5 1.5-1.5H16a5 5 0 0 0 5-5c0-4.4-4-7.8-9-7.8Z"/><circle cx="7.5" cy="10.5" r="1"/><circle cx="12" cy="7.5" r="1"/><circle cx="16.5" cy="10.5" r="1"/>',
  },
  {
    title: 'Built to be found',
    body: 'Every site includes on-page SEO and Google Analytics, so you show up when customers nearby search for what you do.',
    icon: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  },
  {
    title: 'Ready to book clients',
    body: 'Booking integrations, contact forms, and clear calls-to-action so visitors know exactly what to do next, and actually do it.',
    icon: '<rect x="3" y="4.5" width="18" height="16" rx="2.5"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/><path d="m9 15 2 2 4-4"/>',
  },
];
---

<Base title={`Web Design for Small Businesses in ${site.region} | ${site.name}`}>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Web design for {site.region} small businesses</p>
        <h1>Make your website work <span class="hl">for you.</span></h1>
        <p class="lead">
          I create beautiful, strategic websites for local small businesses and solopreneurs. Sites that get you found,
          build trust, and turn visitors into customers.
        </p>
        <div class="btn-row">
          <a href="/contact/#book" class="btn btn--primary">Book a discovery call</a>
          <a href="/free-website-audit/" class="btn btn--secondary">Get a free site audit</a>
        </div>
        <p class="trust">
          <span class="stars" aria-hidden="true">★★★★★</span>
          5.0 on Google · 20 years building websites
        </p>
      </div>

      <div class="mock" aria-hidden="true">
        <div class="mock-window">
          <div class="mock-bar"><i></i><i></i><i></i><span></span></div>
          <div class="mock-body">
            <div class="mock-hero">
              <b class="w60"></b>
              <b class="w40"></b>
              <em></em>
            </div>
            <div class="mock-cards"><b></b><b></b><b></b></div>
          </div>
        </div>
        <div class="mock-chip chip-1">
          <span class="dot"></span> New booking request
        </div>
        <div class="mock-chip chip-2">
          <svg viewBox="0 0 24 24" width="16" height="16"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.5"></circle><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path></svg>
          Found in local search
        </div>
        <svg class="mock-wave" viewBox="0 0 400 60" preserveAspectRatio="none">
          <path d="M0 30c50-25 100-25 150 0s100 25 150 0 75-20 100-10" fill="none" stroke="var(--teal)" stroke-width="3" stroke-linecap="round"></path>
        </svg>
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section class="section section--cream">
    <div class="container narrow">
      <p class="eyebrow">The problem</p>
      <h2>Your website might be the reason customers choose someone else.</h2>
      <p class="lead">
        You’re exceptional at what you do. But when someone searches for your services in your area, what do they
        find?
      </p>
      <ul class="pain">
        <li>A DIY site that doesn’t reflect your quality</li>
        <li>Confusing navigation</li>
        <li>No clear way to book or get in touch</li>
        <li>Copy that sounds like everyone else’s</li>
      </ul>
      <p>Your website is working against you, and you don’t have time to fix it yourself.</p>
      <p class="kicker">That’s where I come in.</p>
    </div>
  </section>

  <!-- Features -->
  <section class="section">
    <div class="container">
      <div class="narrow">
        <p class="eyebrow">What you get</p>
        <h2>Everything you need. Nothing you don’t.</h2>
        <p class="lead">
          I handle the whole thing (design, development, SEO, and launch), so you get a site that looks incredible
          and actually brings in customers.
        </p>
      </div>
      <div class="grid grid--3 features">
        {
          features.map((f) => (
            <article class="card">
              <span class="icon-badge">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={f.icon}
                />
              </span>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Local / who it's for -->
  <section class="section section--navy">
    <div class="container grid grid--2 local">
      <div>
        <p class="eyebrow">Built for your business</p>
        <h2>Local small businesses are my specialty, because I run one too.</h2>
        <p class="muted">
          I work with service businesses and makers across {site.region}, and with clients across the country.
          You get one person who knows your business and picks up when you call.
        </p>
        <a href="/contact/" class="btn btn--secondary">See if we’re a good fit →</a>
      </div>
      <div class="local-panels">
        <div class="panel">
          <h3>I’ve worked with</h3>
          <ul class="tags">
            {clientTypes.map((c) => <li>{c}</li>)}
            <li>…and more</li>
          </ul>
        </div>
        <div class="panel">
          <h3>Proudly serving</h3>
          <ul class="tags">
            {site.areas.map((a) => <li>{a}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section">
    <div class="container">
      <div class="narrow">
        <p class="eyebrow">How it works</p>
        <h2>Simple process. No tech overwhelm.</h2>
      </div>
      <Process />
      <div class="btn-row after">
        <a href="/contact/#book" class="btn btn--primary">Book your free discovery call</a>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="section section--cream" id="pricing">
    <div class="container">
      <div class="narrow center">
        <p class="eyebrow">Pricing</p>
        <h2>Clear, simple pricing.</h2>
        <p class="lead">No surprise invoices. No scope creep. Just a straightforward investment in your business.</p>
      </div>
      <Pricing />
    </div>
  </section>

  <!-- Testimonial -->
  <section class="section">
    <div class="container">
      <Testimonial />
    </div>
  </section>

  <!-- About teaser -->
  <section class="section section--cream">
    <div class="container narrow">
      <p class="eyebrow">Hi, I’m Craig</p>
      <h2>You work with me. Not a junior designer or an overseas contractor.</h2>
      <p>
        I’ve spent 20 years building websites, managing digital projects, and helping businesses show up online with
        confidence. I work with a small number of clients at a time so I can give every project my full attention.
      </p>
      <a href="/about/">More about me →</a>
    </div>
  </section>

  <AuditCta />
</Base>

<style>
  .hero {
    padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(4rem, 9vw, 7rem);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  .hl {
    position: relative;
    white-space: nowrap;
  }
  .hl::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.05em;
    height: 0.22em;
    background: var(--coral);
    opacity: 0.55;
    z-index: -1;
    border-radius: 4px;
  }
  .hero .lead {
    margin-bottom: 2rem;
    max-width: 34rem;
  }
  .trust {
    margin-top: 1.75rem;
    font-family: var(--font-head);
    font-size: 0.9rem;
    color: var(--gray);
  }
  .stars {
    color: var(--coral);
    letter-spacing: 0.1em;
    margin-right: 0.4rem;
  }

  /* Abstract website mockup */
  .mock {
    position: relative;
    padding: 2rem 1rem 3rem;
  }
  .mock-window {
    background: #fff;
    border-radius: 16px;
    border: 1px solid var(--line);
    box-shadow: 0 30px 60px -25px rgb(19 41 61 / 0.35);
    overflow: hidden;
    transform: rotate(-1.5deg);
  }
  .mock-bar {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    padding: 0.8rem 1rem;
    background: var(--cream);
  }
  .mock-bar i {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: #fff;
  }
  .mock-bar span {
    flex: 1;
    height: 0.9rem;
    margin-left: 0.75rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.7);
  }
  .mock-body {
    padding: 1.75rem;
  }
  .mock-hero {
    background: var(--navy);
    border-radius: 12px;
    padding: 1.75rem 1.5rem;
    display: grid;
    gap: 0.6rem;
  }
  .mock-hero b {
    display: block;
    height: 0.8rem;
    border-radius: 999px;
    background: var(--paper);
  }
  .mock-hero .w60 {
    width: 70%;
    height: 1.1rem;
  }
  .mock-hero .w40 {
    width: 45%;
    opacity: 0.5;
  }
  .mock-hero em {
    display: block;
    width: 6.5rem;
    height: 1.9rem;
    margin-top: 0.75rem;
    border-radius: 999px;
    background: var(--coral);
  }
  .mock-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .mock-cards b {
    height: 4.5rem;
    border-radius: 10px;
    background: var(--cream);
  }
  .mock-chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.6rem 1rem;
    font-family: var(--font-head);
    font-size: 0.85rem;
    font-weight: 500;
    box-shadow: var(--shadow);
    white-space: nowrap;
  }
  .chip-1 {
    top: 0.5rem;
    right: 0;
  }
  .chip-2 {
    bottom: 1.25rem;
    left: -0.5rem;
  }
  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 0 4px rgb(36 171 204 / 0.2);
  }
  .mock-wave {
    position: absolute;
    right: -2rem;
    bottom: -0.5rem;
    width: 70%;
    height: 3rem;
    opacity: 0.8;
  }

  .pain {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 2rem;
    display: grid;
    gap: 0.75rem;
  }
  .pain li {
    position: relative;
    padding: 0.9rem 1.1rem 0.9rem 3rem;
    background: rgb(255 253 251 / 0.65);
    border-radius: var(--radius-sm);
  }
  .pain li::before {
    content: '×';
    position: absolute;
    left: 1.1rem;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.3rem;
    color: var(--navy);
    opacity: 0.55;
  }
  .kicker {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.35rem;
  }

  .features {
    margin-top: 3rem;
  }

  .local {
    align-items: center;
  }
  .local-panels {
    display: grid;
    gap: 1.25rem;
  }
  .panel {
    border: 1px solid rgb(244 230 216 / 0.2);
    border-radius: var(--radius);
    padding: 1.75rem;
  }
  .panel h3 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--teal);
  }
  .tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tags li {
    font-family: var(--font-head);
    font-size: 0.9rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: rgb(244 230 216 / 0.1);
  }
  .local .btn {
    margin-top: 1rem;
  }

  .after {
    margin-top: 3rem;
  }
  #pricing .narrow {
    margin-bottom: 3rem;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .mock {
      max-width: 30rem;
    }
  }
  @media (max-width: 480px) {
    .mock-chip {
      font-size: 0.75rem;
    }
    .chip-2 {
      left: 0;
    }
  }
</style>
